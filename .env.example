# Copy to .env.local (never commit real values). Both variables are optional and inlined at build time,
# so rebuild / redeploy after changing them.

# Canonical origin of the deployed site (no trailing slash). Used for metadataBase, Open Graph URLs,
# sitemap.xml and robots.txt. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public base URL that serves the edit videos which are NOT shipped in /public/videos, under their
# original file names (e.g. https://cdn.example.com/edits -> https://cdn.example.com/edits/Cartoons_FINALE.mp4).
# Trailing slashes are trimmed. Unset = the original DigitalOcean Spaces bucket (which no longer exists).
# Any S3 / Cloudflare R2 / Bunny / Cloudinary / Vercel Blob public URL works — see README "Re-hosting videos".
NEXT_PUBLIC_VIDEO_CDN=
